[Unit]
Description=Renew Let's Encrypt certs and reload caddy if renewed
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/root/rag-boilerplate
# certbot's standalone plugin briefly needs port 80 free for the ACME
# challenge; nothing in docker-compose.yml publishes it, so no container
# stop/start is needed around this. --deploy-hook only fires when a cert
# actually renewed, so this is a no-op most days.
ExecStart=/usr/bin/certbot renew --standalone --deploy-hook "/usr/bin/docker compose restart caddy"
